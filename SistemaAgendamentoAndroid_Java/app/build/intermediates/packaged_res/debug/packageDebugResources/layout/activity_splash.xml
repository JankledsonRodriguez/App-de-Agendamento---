<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0061FF">

    <!-- Conteúdo central médico -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Círculo glass com ícone de cruz médica ou similar -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_icon_circle"
            android:elevation="8dp"
            android:layout_marginBottom="32dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_calendar_schedule"
                android:contentDescription="@null"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Nome da Clínica -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name_splash"
            android:textSize="38sp"
            android:fontFamily="sans-serif-black"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.1" />

        <!-- Slogan Médico -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tagline_splash"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:textColor="#B3FFFFFF"
            android:letterSpacing="0.25"
            android:layout_marginTop="12dp" />

        <View
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:background="#4CE0D2"
            android:layout_marginTop="24dp" />

    </LinearLayout>

    <!-- Loader inferior -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        android:orientation="vertical"
        android:gravity="center">

        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            style="?android:attr/progressBarStyleSmall"
            android:indeterminateTint="#4CE0D2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/acessando_prontuario"
            android:textSize="12sp"
            android:textColor="#B3FFFFFF"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</FrameLayout>
