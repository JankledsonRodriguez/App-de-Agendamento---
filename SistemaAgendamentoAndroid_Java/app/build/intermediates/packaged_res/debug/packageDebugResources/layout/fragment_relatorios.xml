<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/relatorios_medicos"
            android:textSize="34sp"
            android:textColor="@color/textPrimary"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.04"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/analise_fluxo"
            android:textSize="15sp"
            android:textColor="@color/textSecondary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="40dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/dividerColor"
            android:backgroundTint="@color/surfaceColor">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/produtividade_diaria"
                    android:textAllCaps="true"
                    android:letterSpacing="0.15"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="?attr/colorPrimary"/>

                <TextView
                    android:id="@+id/txtRelatorio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/gerando_dados_consultas"
                    android:textSize="16sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="6dp"
                    android:fontFamily="sans-serif-medium"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
